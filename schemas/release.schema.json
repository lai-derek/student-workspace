{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release.schema.json",
  "title": "release.json: the tested set of tool versions installed together",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "tools"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "display_name",
          "version",
          "archive",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "archive": {
            "type": "string",
            "pattern": "^(https://|file:)"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "setup_options": {
            "$ref": "tool-manifest.schema.json#/properties/setup_options"
          }
        }
      }
    }
  }
}
